# Uretim derlemesinin genel degiskenleri. Bu dosya repoya girer: icindeki
# degerlerin hicbiri gizli degil ve NEXT_PUBLIC_ oldugu icin zaten tarayiciya
# iniyor. Gizli degerler (GEMINI_API_KEY, TURNSTILE_SECRET_KEY) buraya YAZILMAZ;
# Cloudflare'de "wrangler secret put" ile tanimlanir.

# Turnstile > Sites > Site key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEl7mP2h-pVklaOm

# Gercek alan adi. Origin kontrolu bundan hem apex hem www biçimini turetir.
NEXT_PUBLIC_SITE_URL=https://www.kayayapimimarlik.com
