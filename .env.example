# Bu dosya repoya girer; gercek degerler .env.local icine yazilir (.gitignore'da).

# Google AI Studio > API keys — SADECE sunucuda okunur, asla NEXT_PUBLIC_ yapma.
GEMINI_API_KEY=

# Cloudflare Turnstile > Sites > Secret key — sadece sunucuda okunur.
TURNSTILE_SECRET_KEY=

# Cloudflare Turnstile > Sites > Site key — tarayiciya gonderilir, gizli degildir.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Sitenin genel adresi (Origin kontrolu ve sitemap icin). Uretim degeri
# .env.production dosyasinda durur; .env.local burayi ezdigi icin yerelde
# TANIMLAMA — gelistirmede localhost'a zaten izin veriliyor.
# NEXT_PUBLIC_SITE_URL=

# Cerezsiz olcumdeki gunluk hash'in gizli tuzu — rastgele uzun bir dize.
# Tanimli degilse hicbir olcum kaydi yazilmaz.
#   openssl rand -hex 32
ANALYTICS_SALT=

# Ziyaretci panelinin gizli adresi. Panel sifre sormaz; uc nokta yalnizca bu
# adresi bilen istekleri yanitlar. app/ altindaki klasor adiyla ayni olmali.
ADMIN_PATH=/panel-xxxxxx
