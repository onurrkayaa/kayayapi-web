# Bu dosya repoya girer; gercek degerler .env.local icine yazilir (.gitignore'da).

# Google AI Studio > API keys — SADECE sunucuda okunur, asla NEXT_PUBLIC_ yapma.
GEMINI_API_KEY=

# Cloudflare Turnstile > Sites > Secret key — sadece sunucuda okunur.
TURNSTILE_SECRET_KEY=

# Cloudflare Turnstile > Sites > Site key — tarayiciya gonderilir, gizli degildir.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Sitenin genel adresi (Origin kontrolu ve sitemap icin).
NEXT_PUBLIC_SITE_URL=https://www.kayayapimimarlik.com
